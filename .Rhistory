tibble(Activities = c("1. Initial exploration of the hub infrastrucutre, and usability testing (JR: September - October 2025 , AN: April 2026)",
"2. Insight-gathering discussions with current and former members of the ROBUST team (JR: October - November 2025)",
"3. Development of drafts of user-facing website and user-focused instructional video (JR: January-February 2026)",
"4. Additional signage development and implementation (JR, BC, SM: January-April 2026)",
"5. Engagement with ROBUST app developer (JR: March 2026)",
"6. Workshop materials development (JR: January 2026 onwards)",
"7. Stakeholder workshops (JR, AS: May 2026 onwards)",
"OTHER METHODS TO BE CONFIRMED"),
Discover = c(
"X", "X", "X", "X", "X", "X","X"," "),
Define = c(
"X", " ", "X", "X", " ", "X","X"," "),
Develop = c(
" ", " ", "X", "X", " ", " ","X"," "),
Deliver = c(
" ", " ", "X", "X", " ", " ","X"," ")) %>%
kable(
caption = "Research activities mapped to Double Diamond stages")
