#amenity <- list.load("~/WP4_behaviour_nudging_etc/data/amenity.rdata")
buildings <- list.load("~/WP4_behaviour_nudging_etc/data/buildings.rdata")
hub_location <- list.load("~/WP4_behaviour_nudging_etc/data/hub_location.rdata")
maps_of_street_networks <- list.load("~/WP4_behaviour_nudging_etc/data/maps_of_street_networks.rdata")
net <- list.load("~/WP4_behaviour_nudging_etc/data/net.rdata")
net_bicycle <- list.load("~/WP4_behaviour_nudging_etc/data/net_bicycle.rdata")
net_foot <- list.load("~/WP4_behaviour_nudging_etc/data/net_foot.rdata")
net_motorcar <- list.load("~/WP4_behaviour_nudging_etc/data/net_motorcar.rdata")
placebb <- list.load("~/WP4_behaviour_nudging_etc/data/net_placebb.rdata")
#A1 594 x 841mm
#Lego scale 1 to 42.
map_by_foot_a0_42 <- list()
for(i in seq_along(placebb)){
ylim = c((st_bbox(hub_location[[i]]) %>%
as.numeric())[2] - 14.4144,
(st_bbox(hub_location[[i]]) %>%
as.numeric())[2] + 14.4144)
xlim = c((st_bbox(hub_location[[i]]) %>%
as.numeric())[1] - (14.4144*sqrt(2)),
(st_bbox(hub_location[[i]]) %>%
as.numeric())[1] + (14.4144*sqrt(2)))
Poly_Coord_df = data.frame(xlim, ylim)
poly <- Poly_Coord_df %>%
st_as_sf(coords = c("xlim", "ylim"),
crs = 2157) %>%
st_bbox() %>%
st_as_sfc()
poly_as_lat_long <- poly %>% st_transform(crs = 4326)
map_by_foot_a0_42[[i]] <- ggplot() +
annotation_map_tile(type = "osm", zoom = 19) +
geom_sf(data = st_intersection(buildings[[i]] %>%
st_filter(poly, .predicate =  st_intersects), poly),
mapping = aes(fill = building_type_short)) +
labs(fill = "Building type") +
#  scale_fill_viridis(labels = comma, limits = c(0, 50), option = "H") +
geom_sf(data = hub_location[[i]], size = 1, colour = "red") +
geom_sf(data = poly, size = 1, colour = "black", fill = NA) +
geom_sf(data = st_intersection(net[[i]] %>% st_transform(crs = 2157), poly), aes()) +
geom_sf(data = st_intersection(
net[[i]] %>%
select(osm_id) %>%
st_transform(crs = 2157),
poly) %>%
left_join(net_foot[[i]] %>%
select(d, way_id) %>%
as_tibble(),
by = join_by(osm_id == way_id)),
mapping = aes(colour = d)) +
scale_color_viridis(labels = comma, limits = c(0, 40), option = "C") +
labs(colour = "Walking distance via path/road network (m)") +
theme(
axis.title = element_blank(),
axis.text.x=element_blank(), #remove x axis labels
axis.ticks.x=element_blank(), #remove x axis ticks
axis.text.y=element_blank(),  #remove y axis labels
axis.ticks.y=element_blank(), #remove y axis ticks
legend.position="bottom",
legend.text = element_text(size = 8),
legend.title = element_text(size = 8),
legend.key.size = unit(1, 'cm'),
) +
ggspatial::annotation_scale(location = 'br') +
ggspatial::annotation_north_arrow() +
labs(title = "ROBUST location and surrounds at 1:42 ('LEGO scale')",
subtitle = hub_location[[i]]$name,
caption = "Data and map tile sources: Open Street Maps, © OpenStreetMap contributors")
}
