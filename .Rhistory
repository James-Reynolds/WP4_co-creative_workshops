poly <- Poly_Coord_df %>%
st_as_sf(coords = c("xlim", "ylim"),
crs = 2157) %>%
st_bbox() %>%
st_as_sfc()
poly_as_lat_long <- poly %>% st_transform(crs = 4326)
map_by_foot_a0_500[[i]] <- ggplot() +
ggspatial::annotation_map_tile(type = "osm", zoom = 18) +
geom_sf(data = st_intersection(buildings[[i]] %>%
st_filter(poly, .predicate =  st_intersects), poly),
mapping = aes(fill=distance_by_foot), alpha = 0.25) +
labs(fill = "Walking distance via path/road network (m)") +
scale_fill_viridis(labels = comma, limits = c(0, 800), option = "C") +
geom_sf(data = hub_location[[i]], size = 1, colour = "red") +
geom_sf(data = poly, size = 1, colour = "black", fill = NA) +
geom_sf(data = st_intersection(net[[i]] %>% st_transform(crs = 2157), poly), aes()) +
geom_sf(data = st_intersection(
net[[i]] %>%
select(osm_id) %>%
st_transform(crs = 2157),
poly) %>%
left_join(net_foot[[i]] %>%
select(highway, way_id) %>%
as_tibble(),
by = join_by(osm_id == way_id)),
mapping = aes(linetype = highway)) +
theme(
axis.title = element_blank(),
axis.text.x=element_blank(), #remove x axis labels
axis.ticks.x=element_blank(), #remove x axis ticks
axis.text.y=element_blank(),  #remove y axis labels
axis.ticks.y=element_blank(), #remove y axis ticks
legend.position="bottom",
legend.text = element_text(size = 8),
legend.title = element_text(size = 8),
legend.key.size = unit(1, 'cm'),
) +
ggspatial::annotation_scale(location = 'br') +
ggspatial::annotation_north_arrow() +
labs(title = "ROBUST location and surrounds at 1:500",
subtitle = hub_location[[i]]$name,
caption = "Data and map tile sources: Open Street Maps, © OpenStreetMap contributors")
}
ggsave(file = "graphics/letterkenny_a0_500.png", plot = map_by_foot_a0_500[[1]], height = 810, width = 1145, units = "mm")
