@article{Tight:2011aa,
	abstract = {Walking and cycling can make a considerable contribution to sustainable transport goals, building healthier and more sustainable communities and contributing to traffic and pollution reduction. There have been many national and local initiatives to promote walking and cycling, but without a long term vision and consistent strategy it is difficult to see how a significant change may be achieved. This paper presents three alternative visions for the role of walking and cycling in urban areas for the year 2030: each vision illustrates a `desirable' walking- and cycling-oriented transport system against a different `exogenous social background'. These visions have been developed through a process of expert discussion and review and are intended to provide a stimulus for debate on the potential for and desirability of such alternative futures. Each is based on the UK and represents a substantial change to the current situation: in particular, each of the visions presents a view of a society where walking and cycling are considerably more important than is currently the case and where these modes cater for a much higher proportion of urban transport needs than at present. The visions show pictures of urban environments where dependence on motor vehicles has been reduced, in two of the visions to very low levels. The methodological approach for devising visions is informed by work on `utopian thinking': a key concept underlying this approach is one of viewing the future in social constructivist terms (i.e. the future is what `we', as a society, make it) rather than considering the future as something that can be `scientifically' predicted by the extrapolation of current trends.},
	author = {Miles Tight and Paul Timms and David Banister and Jemma Bowmaker and Jonathan Copas and Andy Day and David Drinkwater and Moshe Givoni and Astrid G{\"u}hnemann and Mary Lawler and James Macmillen and Andrew Miles and Niamh Moore and Rita Newton and Dong Ngoduy and Marcus Ormerod and Maria O'Sullivan and David Watling},
	date-added = {2026-04-02 13:49:39 +1100},
	date-modified = {2026-04-02 13:49:39 +1100},
	doi = {https://doi.org/10.1016/j.jtrangeo.2011.03.011},
	issn = {0966-6923},
	journal = {Journal of Transport Geography},
	keywords = {Walking, Cycling, Visioning, Futures, Sustainable, Transport},
	note = {Special section on Alternative Travel futures},
	number = {6},
	pages = {1580-1589},
	title = {Visions for a walking and cycling focussed urban transport system},
	url = {https://www.sciencedirect.com/science/article/pii/S0966692311001268},
	volume = {19},
	year = {2011},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0966692311001268},
	bdsk-url-2 = {https://doi.org/10.1016/j.jtrangeo.2011.03.011}}

@article{Engel-Yan:2012aa,
	abbrev_source_title = {ITE J},
	abstract = {The key aspects of the Mobility Hub Guidelines developed by Canada's largest metropolitan area, Metrolinx, to direct the planning and development of mobility hubs in the Greater Toronto and Hamilton Area (GTHA), are presented. These aspects include a typology for classifying the current and planned urban context and transportation function at a mobility hub and strategies to overcome challenges in achieving both transport and placemaking roles. Metrolinx has prioritized the mobility hubs into three levels mobility hubs on the currently funded priority projects identified in The Big Move, mobility hubs on the currently unfunded priority projects identified in The Big Move, and all other mobility hubs. For park-and-ride facilities, which can sometimes consume the most attractive properties for development close to a station, the Guideline 4.1 instructs design parking to maximize development and ridership potential at transit stations.},
	affiliations = {Policy and Planning Division at Metrolinx, United States; Policy and Planning Division at Metrolinx, United States},
