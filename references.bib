@article{Beyer:2005aa,
	abbrev_source_title = {Eisenbahningenieur},
	abstract = {The main station at Augsburg is to be converted to make it a more efficient interchange with a view to enhancing the attractiveness of public transport. The joint venture by the Augsburg utility, the city government and DB AG includes an integrated, barrier-free structure that will both increase the capacity of the existing underground walkway, including the platform access ramps, and incorporate a tram stop located on the second underground level. The new efficient interchange will ensure a direct connection between the tram system and DB's local and intercity rail services.},
