@article{Dyer:1991aa,
	abstract = {Eisenhardt (1989) presented an approach to building theory using case studies that summarized a hybrid form of case research. Her approach is paradoxical because, although its purported purpose is theory generation, it includes many of the attributes of hypothesis-testing research. It delivers almost ready-to-test hypotheses based rich qualitative insights, but it focuses so much attention on the constructs developed that the context is often missed. It is feared that this form of case research will not create an examplar, that is, a story against which researchers can compare their experiences and gain rich insights. It is shown that Eisenhardt's approach misses some of the strengths of the classic case study method. In response, Eisenhardt argues that the many classic case studies are fundamentally multiple-case studies, employ the comparative multiple-case logic of replication, and rest on rigorous methods.},
	author = {Dyer, W. and Wilkins, Alan and Eisenhardt, Kathleen},
	date-added = {2026-04-08 16:09:07 +1000},
	date-modified = {2026-04-08 16:09:07 +1000},
	id = {686},
	isbn = {03637425},
	journal = {Academy of Management. The Academy of Management Review},
	keywords = {Research Organizational Behavior Organization Theory Critiques Comparative Studies Case Studies Experimental/Theoretical Treatment},
	number = {3},
	pages = {613},
	st = {Better Stories, Not Better Constructs, to Generate Better Theory: A Rejoinder to Eisenhardt Better Stories and Better Constructs: The Case for Rigor and Comparative Logic},
	title = {Better Stories, Not Better Constructs, to Generate Better Theory: A Rejoinder to Eisenhardt Better Stories and Better Constructs: The Case for Rigor and Comparative Logic},
	volume = {16},
	year = {1991}}

@article{Cavaye:1996aa,
	abstract = {A wide variety of approaches can be applied under the heading of case study research this paper explicitly discusses the range of the alternatives. Many papers discussing case study research emphasize one particular variation of case study research only. The current paper provides an overview of the various uses of case study research in the information systems field by describing the different ways in which case study research can be used, using examples from published IS literature for illustration, and providing references to other method papers for more detailed discussion of each alternative. Researchers are reminded that case study research can be used in the positivist and interpretivist traditions, for testing or building theory, with a single or multiple case study design, using qualitative or mixed methods. The range of case study research alternatives makes it a highly versatile research strategy for IS},
	author = {Cavaye, A. L. M.},
	date-added = {2026-04-08 16:09:07 +1000},
	date-modified = {2026-04-08 16:09:07 +1000},
	doi = {10.1111/j.1365-2575.1996.tb00015.x},
	id = {684},
	isbn = {1350-1917},
	journal = {Information Systems Journal},
	keywords = {Case Study Research Research Methods Pluralism},
	number = {3},
	pages = {227-242},
	st = {Case study research: a multi‐faceted research approach for IS},
	title = {Case study research: a multi‐faceted research approach for IS},
	volume = {6},
	year = {1996},
	bdsk-url-1 = {https://doi.org/10.1111/j.1365-2575.1996.tb00015.x}}

@article{Darke:1998aa,
	abstract = {The organizational and social issues associated with the development, implementation and use of computer‐based information systems have increasingly attracted the attention of information systems researchers. Interest in qualitative research methods such as action research, case study research and ethnography, which focus on understanding social phenomena in their natural setting, has consequently grown. Case study research is the most widely used qualitative research method in information systems research, and is well suited to understanding the interactions between information technology‐related innovations and organizational contexts. Although case study research is useful as a means of studying information systems development and use in the field, there can be practical difficulties associated with attempting to undertake case studies as a rigorous and effective method of research. This paper addresses a number of these difficulties and offers some practical guidelines for successfully completing case study research. The paper focuses on the pragmatics of conducting case study research, and draws from the discussion at a panel session conducted by the authors at the 8th Australasian Conference on Information Systems, September 1997 (ACIS 97), from the authors' practical experiences, and from the case study research literature.},
	author = {Darke, Peta and Shanks, Graeme and Broadbent, Marianne},
	date-added = {2026-04-08 16:09:07 +1000},
	date-modified = {2026-04-08 16:09:07 +1000},
	doi = {10.1046/j.1365-2575.1998.00040.x},
	id = {685},
	isbn = {1350-1917},
	journal = {Information Systems Journal},
	keywords = {Case Study Research Research Methods},
	number = {4},
	pages = {273-289},
	st = {Successfully completing case study research: combining rigour, relevance and pragmatism},
	title = {Successfully completing case study research: combining rigour, relevance and pragmatism},
	volume = {8},
	year = {1998},
	bdsk-url-1 = {https://doi.org/10.1046/j.1365-2575.1998.00040.x}}

@article{Meredith:1998aa,
	abstract = {An increasing body of knowledge in operations research has been developed with the use of case and field studies. The preference for case and field studies over the traditional methods of optimization, simulation and statistical modeling stems from the high level of generalizability that can be achieved from the results of such case or field studies. The validity of case and field studies can be strengthened by applying more rigorous statistical analysis on the studies, which will minimize the deviations of measurements.},
	author = {Meredith, Jack},
