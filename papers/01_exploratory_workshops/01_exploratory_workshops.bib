@article{Meredith:1993aa,
	abstract = {The lack of theories in operations management and the use of theory testing methods alone has produced research results that are largely irrelevant to managers in practice. Theory building emanates from the research cycle of description, explanation and testing but requires all three components to be completed at each iteration of the cycle. Conceptual research methods are based on empirical observation, thus producing relevant results. Six methodologies based on conceptual modelling or frameworks lead to a seventh, meta-frameworks or theory. A theory can be simple but must meet five criteria. Once established, it can be refined and tested to continue empirical research.},
	author = {Meredith, Jack},
	date-added = {2026-11-18 14:59:30 +0000},
	date-modified = {2026-11-18 14:59:30 +0000},
	id = {672},
